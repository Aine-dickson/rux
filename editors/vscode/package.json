{
  "name": "rux",
  "displayName": "Rux",
  "description": "Syntax highlighting, formatting and diagnostics for the Rux UI language (.rux files).",
  "version": "0.2.0",
  "publisher": "aine-dickson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aine-dickson/rux"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Rux",
      "properties": {
        "rux.path": {
          "type": "string",
          "default": "rux",
          "markdownDescription": "Path to the `rux` binary, which provides formatting and diagnostics. Install it with `cargo install ruxlang`. Leave as `rux` to find it on your PATH."
        },
        "rux.check.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report problems from `rux check` as you open and save `.rux` files."
        }
      }
    },
    "languages": [
      {
        "id": "rux",
        "aliases": ["Rux", "rux"],
        "extensions": [".rux"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rux-mark.svg",
          "dark": "./icons/rux-mark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rux",
        "scopeName": "source.rux",
        "path": "./syntaxes/rux.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rux",
        "path": "./snippets/rux.json"
      }
    ]
  }
}
