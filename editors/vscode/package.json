{
  "name": "ruxlang",
  "displayName": "Ruxlang",
  "icon": "icon.png",
  "description": "Syntax highlighting, completions, hover docs, go to definition, an outline, tag auto-closing, formatting and diagnostics for the Rux UI language (.rux files).",
  "version": "0.4.0",
  "publisher": "Ruxlang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aine-dickson/rux"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:rux"
  ],
  "contributes": {
    "configuration": {
      "title": "Rux",
      "properties": {
        "rux.path": {
          "type": "string",
          "default": "rux",
          "markdownDescription": "Path to the `rux` binary, which provides formatting and diagnostics. Install it with `cargo install ruxlang`. Leave as `rux` to find it on your PATH."
        },
        "rux.check.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Report problems from `rux check` as you open and save `.rux` files."
        },
        "rux.format.indent": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "editor", "2", "4", "tab"],
          "enumDescriptions": [
            "Let `rux fmt` decide, which is what `rux fmt` on the command line and in CI will do. Two spaces today.",
            "Use the editor's own tab size. Note that this can disagree with `rux fmt --check`.",
            "Two spaces.",
            "Four spaces.",
            "One tab."
          ],
          "markdownDescription": "Indent width for Format Document. `auto` asks `rux fmt` for nothing and lets the binary decide, so the editor and `rux fmt --check` cannot disagree. Anything else overrides it."
        },
        "rux.autoClosingTags": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Write the closing tag when you finish an opening one, and complete `</`. Void elements (`<image>`, `<input>`) are never given a closing tag."
        }
      }
    },
    "languages": [
      {
        "id": "rux",
        "aliases": [
          "Rux",
          "rux"
        ],
        "extensions": [
          ".rux"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/rux-mark.svg",
          "dark": "./icons/rux-mark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rux",
        "scopeName": "source.rux",
        "path": "./syntaxes/rux.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rux.showVocabulary",
        "title": "Show Vocabulary Source",
        "category": "Rux"
      },
      {
        "command": "rux.run",
        "title": "Run Rux File",
        "category": "Rux",
        "icon": "$(play)"
      },
      {
        "command": "rux.check",
        "title": "Check Rux File",
        "category": "Rux"
      },
      {
        "command": "rux.diagnose",
        "title": "Diagnose Editor Support At Cursor",
        "category": "Rux"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rux.run",
          "when": "resourceLangId == rux",
          "group": "navigation@1"
        },
        {
          "command": "rux.check",
          "when": "resourceLangId == rux",
          "group": "navigation@2"
        },
        {
          "command": "rux.diagnose",
          "when": "resourceLangId == rux",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "rux.run",
          "when": "resourceExtname == .rux",
          "group": "navigation@1"
        },
        {
          "command": "rux.check",
          "when": "resourceExtname == .rux",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "rux.run",
          "when": "resourceLangId == rux",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "rux.run",
          "when": "resourceLangId == rux"
        },
        {
          "command": "rux.check",
          "when": "resourceLangId == rux"
        },
        {
          "command": "rux.diagnose",
          "when": "resourceLangId == rux"
        }
      ]
    }
  }
}
