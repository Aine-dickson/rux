<template>
  <screen class="app">
    <text class="title">position</text>
    <text class="lead">All four values, and the two that used to be silent. Scroll the list: the fixed badge stays put, the sticky headings ride the top and hand over, and the absolute one goes with the content.</text>

    <view class="frame">
      <!-- No `position` on this wrapper, so it is `static`, so it is not a
           containing block and the cover below skips it for `.frame`. -->
      <view class="wrapper">
        <view class="cover"><text class="tag">absolute, all insets 0, measured against .frame and not against the static wrapper it sits in</text></view>
      </view>
    </view>

    <view class="scroller">
      <!-- Sticky: in flow until the scroller's top edge reaches it, then riding
           that edge, then pushed off by the end of its own section. -->
      <view class="section" r-for="s in sections">
        <view class="head"><text class="head-text">{{ s.name }}</text></view>
        <view class="row" r-for="n in s.rows"><text class="row-text">{{ s.name }} row {{ n }}</text></view>
      </view>
      <!-- Out of the flow but inside the scroller, so it travels with it. -->
      <view class="rider"><text class="tag">absolute: rides the content</text></view>
    </view>

    <!-- Fixed to the window: outside every scroller, whatever it is written
         inside. -->
    <view class="badge"><text class="tag">fixed: stays</text></view>
  </screen>
</template>

<style>
  .app {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: #1e1e2e;
  }

  .title { color: #cdd6f4; font-size: 22px; font-weight: 700; }
  .lead { color: #a6adc8; font-size: 13px; line-height: 20px; }
  .tag { color: #1e1e2e; font-size: 12px; font-weight: 700; line-height: 16px; }

  /* The containing block, said out loud, which is what CSS asks for and what
     Rux now honors. */
  .frame {
    position: relative;
    width: 100%;
    height: 110px;
    background: #181825;
    border-radius: 10px;
  }

  /* Says nothing, so `static`, so not a containing block. */
  .wrapper { width: 120px; height: 40px; }

  .cover {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    padding: 10px;
    background: #89b4fa;
    border-radius: 10px;
  }

  .scroller {
    position: relative;
    width: 100%;
    height: 200px;
    overflow-y: auto;
    background: #181825;
    border-radius: 10px;
  }

  .section { display: flex; flex-direction: column; width: 100%; flex-shrink: 0; }

  .head {
    position: sticky;
    top: 0;
    width: 100%;
    flex-shrink: 0;
    padding: 8px 14px;
    background: #89b4fa;
  }
  .head-text { color: #1e1e2e; font-size: 13px; font-weight: 700; }

  .row { padding: 10px 14px; flex-shrink: 0; }
  .row-text { color: #cdd6f4; font-size: 14px; }

  .rider {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 6px 10px;
    background: #a6e3a1;
    border-radius: 8px;
  }

  .badge {
    position: fixed;
    bottom: 16px;
    right: 16px;
    padding: 8px 12px;
    background: #f9e2af;
    border-radius: 8px;
  }
</style>

<script>
  let sections = signal([
    #{ name: "first", rows: [1, 2, 3, 4, 5, 6] },
    #{ name: "second", rows: [1, 2, 3, 4, 5, 6] },
    #{ name: "third", rows: [1, 2, 3, 4, 5, 6] },
  ]);
</script>
