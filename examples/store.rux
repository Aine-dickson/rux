<template>
  <screen class="app">
    <view class="head">
      <text class="title">A store</text>
      <basket />
    </view>
    <text class="lead">The basket lives in stores/cart.rux, a file with no template. Every card adds to it and both badges show it, because a module is loaded once and every file that imports it reads the same state. Only the store's own functions change it.</text>
    <view class="shelf">
      <product r-for="p in catalog" r-key="p.name" :name="p.name" :price="p.price" />
    </view>
    <view class="foot">
      <basket />
      <view class="btn" @tap="cart.clear()"><text class="btn-label">empty the basket</text></view>
    </view>
  </screen>
</template>

