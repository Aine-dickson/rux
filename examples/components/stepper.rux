<template>
  <view class="stepper">
    <text class="name">{{ label }}</text>
    <view class="controls">
      <!-- The count belongs to this component. The caller never sees it, and
           does not need to: what it hears about is the change. -->
      <view class="step" @tap="if count > 0 { count = count - 1; emit(&quot;change&quot;, -1) }">
        <text class="sign">-</text>
      </view>
      <text class="count">{{ count }}</text>
      <view class="step" @tap="count = count + 1; emit(&quot;change&quot;, 1)">
        <text class="sign">+</text>
      </view>
    </view>
    <!-- The payload is read where `emit` is written, so this sends the count
         it had a moment ago and then clears it. -->
    <view class="clear" @tap="emit(&quot;change&quot;, 0 - count); count = 0">
      <text class="clear-label">clear</text>
    </view>
  </view>
</template>

<style>
  .stepper {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 200px;
    padding: 14px;
    background: #313244;
    border: 2px solid #45475a;
    border-radius: 10px;
  }

  .name { color: #cdd6f4; font-size: 14px; font-weight: 700; }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .step {
    display: flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    background: #45475a;
    border-radius: 8px;
    cursor: pointer;
  }

  .step:hover { background: #585b70; }
  .sign { color: #cdd6f4; font-size: 18px; font-weight: 700; }
  .count { color: #a6e3a1; font-size: 20px; font-weight: 700; }

  .clear {
    align-items: center;
    padding: 5px;
    border-radius: 6px;
    cursor: pointer;
  }

  .clear:hover { background: #45475a; }
  .clear-label { color: #6c7086; font-size: 12px; }
</style>

<script>
  let count = signal(0);
</script>
