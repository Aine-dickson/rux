<template>
  <screen class="app">
    <text class="title">component slots</text>
    <text class="lead">One panel component, three different contents. The markup between the tags is written out here, reads the signals out here, and is styled by this file's rules. The panel only decides where it goes.</text>

    <view class="row">
      <panel :title="&quot;stats&quot;" :badge="count + &quot; today&quot;">
        <text class="stat">{{ count }}</text>
        <text class="note">taps so far</text>
        <view class="btn" @tap="count++">
          <text class="btn-label">one more</text>
        </view>
      </panel>

      <panel :title="&quot;notes&quot;" :badge="&quot;2&quot;">
        <text class="note">Slot content can be anything, including another component.</text>
        <text class="note">It is ordinary markup in this file.</text>
      </panel>

      <panel :title="&quot;empty&quot;" :badge="&quot;0&quot;" />
    </view>
  </screen>
</template>

<style>
  .app {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: #1e1e2e;
  }

  .title { color: #cdd6f4; font-size: 22px; font-weight: 700; }
  .lead { color: #9399b2; font-size: 13px; max-width: 620px; }
  .row { display: flex; gap: 16px; align-items: flex-start; }

  /* These rules style the slot content, and the component never sees them. */
  .stat { color: #a6e3a1; font-size: 28px; font-weight: 700; }
  .note { color: #9399b2; font-size: 13px; }

  .btn {
    padding: 6px 12px;
    background: #89b4fa;
    border-radius: 8px;
    cursor: pointer;
  }

  .btn:hover { background: #b4befe; }
  .btn-label { color: #11111b; font-size: 12px; font-weight: 700; }
</style>

<script>
  use components::panel;

  let count = signal(0);
</script>
