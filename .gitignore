/target
**/*.rs.bk
Cargo.lock.orig

# The browser bundle, generated by `wasm-bindgen` from crates/rux-web.
# Built in CI (see .github/workflows/site.yml) rather than committed. It is
# ~7 MB, and a binary that large has no business in the history of a repo whose
# whole source tree is smaller.
/site/static/wasm/

# Release artifacts are built on demand, not committed.
/dist/
*.vsix

/.claude

# Local editor settings. `.vscode/settings.json` here points `rux.path` at a
# branch build by absolute path, which is right on one machine and wrong on
# every other, and it spells out a home directory on a public repo.
/.vscode/
